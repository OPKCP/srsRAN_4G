@echo off
chcp 65001 >nul
title Стенд LTE - Мониторинг (веб-страницы)
echo ============================================================
echo   СТЕНД LTE (srsRAN 4G) - ОТКРЫТИЕ СТРАНИЦ МОНИТОРИНГА
echo ============================================================
echo.
echo   Открываются страницы в браузере по умолчанию.
echo   Компьютер должен быть в сети Wi-Fi "IS-1".
echo.
echo   Если страница не открылась - стенд ещё запускается,
echo   подождите 10-20 секунд и обновите страницу (F5).
echo ============================================================
echo.
start "" "http://192.168.1.26:5001"
timeout /t 1 >nul
start "" "http://192.168.1.26:5000"
timeout /t 1 >nul
start "" "http://192.168.1.25:5000"
timeout /t 1 >nul
start "" "http://192.168.1.26:3000"
echo.
echo   Открыты:
echo     дашборд ядра      http://192.168.1.26:5001
echo     дашборд БС2       http://192.168.1.26:5000
echo     дашборд БС1       http://192.168.1.25:5000
echo     Grafana           http://192.168.1.26:3000   (логин admin / пароль admin)
echo.
echo   Веб-сервер стенда для ТЕЛЕФОНА (не для компьютера):
echo     http://10.0.0.1:8080
echo ============================================================
pause
